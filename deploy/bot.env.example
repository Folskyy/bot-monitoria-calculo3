# Exemplo de configuracao para producao (/etc/monitoria-bot/bot.env)
# Permissoes recomendadas: chown root:monitoria /etc/monitoria-bot/bot.env && chmod 640 /etc/monitoria-bot/bot.env

DISCORD_TOKEN=coloque_aqui_o_token_do_bot
DATABASE_PATH=/opt/monitoria-bot/data/bot.db
LOG_LEVEL=INFO
LOG_FILE=bot.log
RA_REGEX=^[A-Za-z0-9]{1,32}$
