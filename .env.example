# Token do bot no Discord (obrigatório em produção)
DISCORD_TOKEN=

# Caminho do banco de dados SQLite local
DATABASE_PATH=./data/bot.db

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Expressão regular para validação do RA (fallback padrão: 1 a 32 caracteres alfanuméricos)
RA_REGEX=^[A-Za-z0-9]{1,32}$

# ID do servidor Discord para sincronização imediata de comandos em ambiente de desenvolvimento (opcional)
DISCORD_GUILD_ID=
